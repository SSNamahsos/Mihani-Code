# Mihani key-protecting gateway — example config.
# Copy to .env.local (git-ignored) and fill in real values. NEVER commit real keys.
# In production, set these as platform secrets (Fly/Render/VPS) instead of a file.

# Listen port (default :8080)
PORT=8080

# "Mihani Pro" upstream (client calls /pro/...)
PRO_BASE=https://seekai.cc/v1
PRO_KEY=sk-REPLACE-WITH-SEEKAI-KEY

# "Mihani Cloud" upstream (client calls /cloud/...)
CLOUD_BASE=https://api.hcnsec.cn/v1
CLOUD_KEY=sk-REPLACE-WITH-HCSEC-KEY

# Comma-separated client tokens the app must present (REQUIRED in production).
# The app sets MIHANI_GATEWAY_TOKEN to one of these.
CLIENT_TOKENS=replace-with-a-long-random-token

# Limits (optional)
RATE_PER_MIN=30
BURST=8
MAX_CONCURRENT=8
